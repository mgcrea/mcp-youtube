# ── Credentials ──────────────────────────────────────────────────────────────
# An OAuth client of type "Desktop app" from a Google Cloud project that has the
# YouTube Data API v3 enabled: Google Auth Platform → Clients → Create client.
# https://console.cloud.google.com/auth/clients
# No redirect URI to register: Desktop clients accept any loopback port.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Optional: a refresh token from elsewhere (Docker, CI). Held in memory only;
# without it, youtube_auth_login stores one in ~/.config/youtube/tokens.json.
YOUTUBE_REFRESH_TOKEN=

# Optional: where the login is stored. Defaults to ~/.config/youtube/tokens.json.
YOUTUBE_TOKEN_FILE=

# ── Safety ───────────────────────────────────────────────────────────────────
# Set to 1 to register the WRITE tools, youtube_upload_video included. Off by
# default: the mutating tools are then never registered, so an agent cannot
# call them at all. Delete additionally requires confirm: true.
YOUTUBE_ALLOW_WRITES=

# Optional: the channel id (UC...) the token must act as. The consent screen is
# where a Brand Account channel is picked, so a login can land on the wrong one;
# with this set, every tool refuses on a mismatch instead.
YOUTUBE_CHANNEL_ID=

# ── Optional tuning ──────────────────────────────────────────────────────────
# Upload chunk size in MiB (rounded down to 256 KiB). Defaults to 16.
YOUTUBE_CHUNK_SIZE_MB=
# Retry budget for 429 / 5xx responses. Defaults to 3 (5 for upload chunks).
YOUTUBE_MAX_RETRIES=
# Per-request timeout for API calls in ms. Defaults to 30000.
YOUTUBE_TIMEOUT_MS=
# Set to 1 to log debug output to stderr.
YOUTUBE_DEBUG=
